{
  "name": "workers-turbo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "worker-1": "wrangler dev --env dev -c ./workers/my-worker/dist/wrangler.jsonc --port 9000 --inspector-port 9230",
    "worker-2": "wrangler dev --env dev -c ./workers/second-worker/dist/wrangler.jsonc --port 9001 --inspector-port 9231",
    "start": "concurrently \"npm:worker-1\" \"npm:worker-2\""
  },
  "dependencies": {
    "hono": "^4.7.8",
    "oclif": "^4.22.22"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250806.0",
    "concurrently": "^9.2.0",
    "prettier": "^3.5.3",
    "turbo": "^2.5.2",
    "typescript": "^5.8.3",
    "wrangler": "^4.28.0"
  },
  "packageManager": "npm@11.3.0",
  "engines": {
    "node": ">=18"
  },
  "workspaces": [
    "workers/*",
    "packages/*"
  ],
  "bin": {
    "mono-cf": "../../bin/run.js"
  }
}
