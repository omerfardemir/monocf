{
  "name": "monocf",
  "description": "MonoCF for manage Cloudflare Workers in monorepo",
  "version": "0.2.1",
  "author": "Omer Demir",
  "bin": {
    "monocf": "./bin/run.js"
  },
  "bugs": "https://github.com/omerfardemir/monocf/issues",
  "dependencies": {
    "@bluwy/giget-core": "^0.1.2",
    "@oclif/core": "^4.5.3",
    "dotenv": "^16.5.0",
    "ignore": "^7.0.5",
    "jsonc-parser": "^3.3.1",
    "nanospinner": "^1.2.2"
  },
  "devDependencies": {
    "@eslint/compat": "^1",
    "@oclif/prettier-config": "^0.2.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "^9",
    "eslint-config-oclif": "^6",
    "eslint-config-prettier": "^10",
    "oclif": "^4.22.22",
    "prettier": "^3.9.10",
    "shx": "^0.3.3",
    "typescript": "^5",
    "vitest": "^5.1.0",
    "wrangler": "4.151.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "./bin",
    "./dist",
    "./oclif.manifest.json"
  ],
  "homepage": "https://github.com/omerfardemir/monocf",
  "keywords": [
    "cloudflare-workers",
    "monorepo",
    "wrangler"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "type": "module",
  "oclif": {
    "bin": "monocf",
    "commands": "./dist/commands",
    "dirname": "monocf",
    "topicSeparator": " "
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omerfardemir/monocf.git"
  },
  "scripts": {
    "build": "shx rm -f tsconfig.tsbuildinfo && shx rm -rf dist && tsc -b",
    "lint": "eslint",
    "postpack": "shx rm -f oclif.manifest.json",
    "posttest": "npm run lint",
    "prepack": "oclif manifest",
    "test": "vitest run",
    "format": "prettier --write \"(src|test)/**/*.{ts,tsx,js,jsx}\""
  },
  "types": "dist/index.d.ts",
  "peerDependencies": {
    "wrangler": ">=4.151.0"
  }
}
